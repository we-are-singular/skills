{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "oxc", "import", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "style": "warn",
    "pedantic": "off"
  },
  "env": {
    "es2024": true,
    "node": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.cache/**",
    "**/.turbo/**",
    "**/.output/**",
    "**/.build/**",
    "**/build/**",
    "**/dist/**",
    "**/coverage/**",
    "**/*.gen.*",
    "**/generated/**"
  ],
  "rules": {
    "eslint/no-unused-vars": "error",
    "typescript/no-unused-vars": "error",
    "eslint/no-undef": "error",
    "eslint/no-duplicate-imports": ["error", { "allowSeparateTypeImports": true }],
    "import/first": "off",
    "import/group-exports": "off",
    "import/no-duplicates": "off",
    "import/consistent-type-specifier-style": "off",
    "import/no-nodejs-modules": "off",
    "import/no-named-export": "off",
    "import/no-anonymous-default-export": "off",
    "import/prefer-default-export": "off",
    "import/exports-last": "off",
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css", "**/*.scss"] }],

    "eslint/no-var": "error",
    "eslint/prefer-const": "error",
    "eslint/no-continue": "off",
    "eslint/new-cap": "off",
    "eslint/curly": "off",
    "eslint/no-nested-ternary": "off",
    "eslint/no-ternary": "off",
    "eslint/id-length": "off",
    "eslint/sort-imports": "off",
    "eslint/sort-keys": "allow",
    "eslint/sort-vars": "off",
    "eslint/capitalized-comments": "off",
    "eslint/prefer-template": "error",
    "eslint/default-param-last": "error",
    "eslint/no-param-reassign": "error",
    "func-style": "off",
    "typescript/array-type": "off",
    "typescript/consistent-type-imports": "error",
    "typescript/consistent-type-exports": "error",
    "typescript/consistent-type-definitions": "off",
    "unicorn/filename-case": ["error", { "cases": { "kebabCase": true } }],

    "typescript/no-explicit-any": "warn",
    "typescript/no-non-null-assertion": "warn",
    "eslint/init-declarations": "off",
    "eslint/no-console": ["warn", { "allow": ["warn", "error", "info"] }],
    "eslint/eqeqeq": "error",
    "eslint/no-debugger": "error",
    "eslint/no-async-promise-executor": "error",
    "eslint/no-alert": "error",
    "eslint/no-empty": "error",
    "eslint/no-empty-static-block": "error",
    "eslint/no-magic-numbers": "off",
    "eslint/no-shadow": "warn",

    "typescript/no-extraneous-class": "off",
    "typescript/no-unnecessary-type-constraint": "error",
    "unicorn/no-array-for-each": "warn",
    "unicorn/prefer-optional-catch-binding": "error",
    "unicorn/prefer-array-flat-map": "error",
    "eslint/prefer-object-has-own": "error",
    "eslint/max-statements": ["warn", 100],
    "eslint/max-params": ["warn", 6],

    "oxc/no-barrel-file": "warn"
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/tests/**/*.ts",
        "**/tests/**/*.tsx"
      ],
      "plugins": ["vitest"],
      "globals": {
        "beforeEach": "readonly",
        "afterEach": "readonly",
        "beforeAll": "readonly",
        "afterAll": "readonly",
        "aroundEach": "readonly",
        "aroundAll": "readonly",
        "describe": "readonly",
        "suite": "readonly",
        "it": "readonly",
        "test": "readonly",
        "expect": "readonly",
        "assert": "readonly",
        "chai": "readonly",
        "expectTypeOf": "readonly",
        "assertType": "readonly",
        "onTestFailed": "readonly",
        "onTestFinished": "readonly",
        "vi": "readonly",
        "vitest": "readonly"
      },
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/no-non-null-assertion": "off",
        "eslint/max-statements": "off",
        "unicorn/filename-case": "off",
        "unicorn/no-array-for-each": "off",
        "eslint/func-names": "off",
        "eslint/prefer-destructuring": "off",
        "vitest/prefer-importing-vitest-globals": "off",
        "vitest/prefer-called-times": "off",
        "vitest/prefer-expect-type-of": "off"
      }
    }
  ]
}
